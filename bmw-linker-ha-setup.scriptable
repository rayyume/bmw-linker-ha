{
  "always_run_in_app": true,
  "icon": {
    "color": "blue",
    "glyph": "mobile-alt"
  },
  "name": "bmw-linker-ha-setup",
  "script": "const bridgeCode = \"// Installed by bmw-linker-ha-setup before the widget starts.\\n{\\n  const pushVehicleState = async (snapshot, webhookUrl) => {\\n    if (!isHaWebhookUrl(webhookUrl)) {\\n      console.log(\\\"[My BMW HA] 请填写集成显示的完整 Webhook URL。\\\");\\n      return;\\n    }\\n\\n    const rawTimestamp = snapshot?.lastUpdatedAt;\\n    const reportedAt = rawTimestamp ? new Date(rawTimestamp) : null;\\n    if (!reportedAt || !Number.isFinite(reportedAt.getTime())) {\\n      console.log(\\\"[My BMW HA] 车辆数据缺少有效的上报时间。\\\");\\n      return;\\n    }\\n\\n    const fuel = snapshot.combustionFuelLevel;\\n    const electric = snapshot.electricChargingState;\\n    const security = snapshot.doorsState?.combinedSecurityState;\\n    const doorState = {\\n      LOCKED: \\\"LOCKED\\\",\\n      SECURED: \\\"LOCKED\\\",\\n      UNLOCKED: \\\"UNLOCKED\\\",\\n      SELECTIVE_LOCKED: \\\"UNLOCKED\\\",\\n      PARTIALLY_LOCKED: \\\"UNLOCKED\\\",\\n    }[security];\\n\\n    try {\\n      const request = new Request(webhookUrl);\\n      request.method = \\\"POST\\\";\\n      request.headers = { \\\"Content-Type\\\": \\\"application/json\\\" };\\n      request.timeoutInterval = 4;\\n      request.onRedirect = () => null;\\n      request.body = JSON.stringify({\\n        version: 1,\\n        reported_at: reportedAt.toISOString(),\\n        battery_percent: nonnegativeNumber(electric?.chargingLevelPercent),\\n        fuel_percent: nonnegativeNumber(fuel?.remainingFuelPercent),\\n        fuel_range_km: nonnegativeNumber(fuel?.range),\\n        electric_range_km: nonnegativeNumber(electric?.range),\\n        odometer_km: nonnegativeNumber(snapshot.currentMileage),\\n        door_state: doorState,\\n      });\\n\\n      const receipt = await request.loadJSON();\\n      if (request.response.statusCode !== 200) throw new Error();\\n      if (receipt?.mybmw_bridge === \\\"updated\\\") {\\n        console.log(\\\"[My BMW HA] 已更新车辆状态。\\\");\\n      } else if (receipt?.mybmw_bridge === \\\"unchanged\\\") {\\n        console.log(\\\"[My BMW HA] 已收到，车辆上报时间没有更新。\\\");\\n      } else {\\n        throw new Error();\\n      }\\n    } catch {\\n      console.log(\\\"[My BMW HA] 未收到确认，请检查网络、Webhook 地址和车辆数据。\\\");\\n    }\\n  };\\n\\n  function isHaWebhookUrl(value) {\\n    return /^https?:\\\\/\\\\/[^\\\\s/?#@\\\\\\\\]+\\\\/api\\\\/webhook\\\\/[a-f0-9]{64}$/.test(value);\\n  }\\n\\n  function nonnegativeNumber(value) {\\n    if (typeof value === \\\"string\\\" && value.trim() !== \\\"\\\") value = Number(value);\\n    return Number.isFinite(value) && value >= 0 ? value : undefined;\\n  }\\n\\n  const webhookKey = \\\"bmw-linker-ha.webhook-url.\\\" + Script.name();\\n  const menuName = \\\"bmwLinkerHaWebhook\\\";\\n  const readWebhook = () => Keychain.contains(webhookKey) ? Keychain.get(webhookKey) : \\\"\\\";\\n  const webhookStatus = () => readWebhook() ? \\\"已设置\\\" : \\\"未设置\\\";\\n\\n  Widget = class extends Widget {\\n    async getAppViewOptions() {\\n      const options = await super.getAppViewOptions();\\n      return {\\n        ...options,\\n        settingItems: [\\n          {\\n            name: menuName,\\n            label: \\\"Home Assistant Webhook\\\",\\n            type: \\\"cell\\\",\\n            icon: { name: \\\"house.fill\\\", color: \\\"#1699cb\\\" },\\n            needLoading: true,\\n            desc: webhookStatus(),\\n          },\\n          ...options.settingItems,\\n        ],\\n        onItemClick: async (item, ...args) => {\\n          if (item.name !== menuName) return options.onItemClick(item, ...args);\\n\\n          const alert = new Alert();\\n          alert.title = \\\"Home Assistant Webhook\\\";\\n          alert.message = \\\"粘贴 HA 集成生成的完整 Webhook URL。清空后保存可停用推送。\\\";\\n          alert.addSecureTextField(\\\"Webhook URL\\\", readWebhook());\\n          alert.addAction(\\\"保存\\\");\\n          alert.addCancelAction(\\\"取消\\\");\\n          if (await alert.presentAlert() === 0) {\\n            const url = alert.textFieldValue(0).trim();\\n            if (!url) {\\n              if (Keychain.contains(webhookKey)) Keychain.remove(webhookKey);\\n            } else if (isHaWebhookUrl(url)) {\\n              Keychain.set(webhookKey, url);\\n            } else {\\n              await this.generateAlert(\\\"地址有误\\\", \\\"请粘贴 HA 集成显示的完整 Webhook URL。\\\", [\\\"确定\\\"]);\\n            }\\n          }\\n          return { desc: { value: webhookStatus() } };\\n        },\\n      };\\n    }\\n\\n    async getData(forceRefresh = false) {\\n      const data = await super.getData(forceRefresh);\\n      if (!forceRefresh && data?.properties && !data.black) {\\n        const url = readWebhook();\\n        if (url) await pushVehicleState(data.properties, url);\\n      }\\n      return data;\\n    }\\n  };\\n}\\n\";\nconst configuredMenu = 'const menuName = \"bmwLinkerHaWebhook\";';\n\nfunction scriptFolders() {\n  const local = FileManager.local();\n  const folders = [{ manager: local, path: local.documentsDirectory() }];\n  let cloud;\n  try {\n    cloud = FileManager.iCloud();\n    const cloudPath = cloud.documentsDirectory();\n    if (cloudPath) folders.push({ manager: cloud, path: cloudPath });\n  } catch {\n    // The device may have iCloud Drive disabled.\n  }\n\n  const scriptDirectory = module.filename.slice(0, module.filename.lastIndexOf(\"/\"));\n  if (scriptDirectory) {\n    const manager = cloud && local.isFileStoredIniCloud(module.filename) ? cloud : local;\n    folders.unshift({ manager, path: scriptDirectory });\n  }\n  const unique = new Map();\n  for (const folder of folders) {\n    const key = folder.path.replace(/^\\/private(?=\\/var\\/)/, \"\").replace(/\\/+$/, \"\");\n    if (!unique.has(key)) unique.set(key, folder);\n  }\n  return [...unique.values()];\n}\n\nfunction locateScript(name, folders) {\n  const found = folders\n    .map(({ manager, path }) => ({ manager, path: manager.joinPath(path, name + \".js\") }))\n    .filter(({ manager, path }) =>\n      path !== module.filename && manager.fileExists(path) && !manager.isDirectory(path));\n  if (found.length === 0) {\n    throw new Error(\"找不到「\" + name + \"」。请输入 Scriptable 中显示的完整脚本名称。\");\n  }\n  if (found.length > 1) {\n    throw new Error(\"发现多份同名脚本「\" + name + \"」。请先给不同车辆的脚本设置不同名称。\");\n  }\n  return { name, ...found[0] };\n}\n\nasync function chooseScript() {\n  const folders = scriptFolders();\n  const helperNames = new Set([\"bmw-linker-ha-setup\", \"bmw-linker-ha-bridge\", \"bmw-linker-ha-inline\"]);\n  const names = new Set();\n  for (const { manager, path } of folders) {\n    let files;\n    try {\n      if (!manager.fileExists(path)) continue;\n      files = manager.listContents(path);\n    } catch {\n      continue;\n    }\n    for (const file of files) {\n      if (!/^bmw-linker.*\\.js$/i.test(file)) continue;\n      const name = file.slice(0, -3);\n      const filePath = manager.joinPath(path, file);\n      if (\n        !helperNames.has(name.toLowerCase()) &&\n        filePath !== module.filename &&\n        !manager.isDirectory(filePath)\n      ) {\n        names.add(name);\n      }\n    }\n  }\n\n  const suggested = [...names].sort((left, right) => left.localeCompare(right));\n  const chooser = new Alert();\n  chooser.title = \"选择要安装或恢复桥接的脚本\";\n  for (const name of suggested) chooser.addAction(name);\n  chooser.addAction(\"手工输入脚本名\");\n  chooser.addCancelAction(\"取消\");\n  const action = await chooser.presentSheet();\n  if (action < 0) return null;\n  if (action < suggested.length) return locateScript(suggested[action], folders);\n\n  const prompt = new Alert();\n  prompt.title = \"输入 Scriptable 脚本名称\";\n  prompt.addTextField(\"例如 宝马 i4\");\n  prompt.addAction(\"继续\");\n  prompt.addCancelAction(\"取消\");\n  if (await prompt.presentAlert() !== 0) return null;\n  const name = prompt.textFieldValue(0).trim().replace(/\\.js$/i, \"\");\n  if (!name || /[/\\\\\\u0000-\\u001f]/.test(name) || helperNames.has(name.toLowerCase())) {\n    throw new Error(\"请输入 BMW 脚本名称，填写 Scriptable 列表里显示的名称即可。\");\n  }\n  return locateScript(name, folders);\n}\n\nfunction addBridge(original) {\n  if (original.includes(configuredMenu)) return original;\n\n  // Remove the exact module call from the previous installation guide.\n  const oldModuleCall = /^([ \\t]*let data = await this\\.getData\\(\\);\\r?\\n)[ \\t]*if \\(data\\?\\.properties && !data\\.black\\) \\{\\r?\\n[ \\t]*try \\{\\r?\\n[ \\t]*await importModule\\(\"(?:bmw-linker-ha-bridge|scriptable-bridge)\"\\)\\.pushVehicleState\\(data\\.properties\\);\\r?\\n[ \\t]*\\} catch \\{\\r?\\n[ \\t]*console\\.log\\(\"\\[My BMW HA\\] 无法调用发送脚本，请检查脚本名称。\"\\);\\r?\\n[ \\t]*\\}\\r?\\n[ \\t]*\\}\\r?\\n/m;\n  const updated = original.replace(oldModuleCall, \"$1\");\n  if (/pushVehicleState|HA_WEBHOOK_URL|\\[My BMW HA\\]/.test(updated)) {\n    throw new Error(\"检测到其他版本的桥接代码。安装器已保留原脚本，请先用未加桥接的 bmw-linker 运行安装。\");\n  }\n  const startups = [...updated.matchAll(/^[ \\t]*await\\s+new\\s+Widget\\s*\\(\\s*Script\\.name\\s*\\(\\s*\\)\\s*,\\s*\\{/gm)];\n  if (\n    startups.length !== 1 ||\n    !/\\bclass\\s+Widget\\s+extends\\s+BaseWidget\\b/.test(updated) ||\n    !/\\basync\\s+getAppViewOptions\\s*\\(/.test(updated) ||\n    !/\\basync\\s+getData\\s*\\(/.test(updated)\n  ) {\n    throw new Error(\"这个 bmw-linker 版本的入口与安装器不匹配，原脚本已保留。\");\n  }\n\n  const lineEnding = updated.includes(\"\\r\\n\") ? \"\\r\\n\" : \"\\n\";\n  const patch = bridgeCode.replace(/\\n/g, lineEnding);\n  const { index } = startups[0];\n  return updated.slice(0, index) + patch + lineEnding + updated.slice(index);\n}\n\nasync function installBridge() {\n  const script = await chooseScript();\n  if (!script) return;\n  const { manager, name, path } = script;\n  if (manager.isFileStoredIniCloud(path)) await manager.downloadFileFromiCloud(path);\n  const original = manager.readString(path);\n  const updated = addBridge(original);\n  if (updated === original) return \"「\" + name + \"」已安装桥接。\";\n\n  if (manager.readString(path) !== original) {\n    throw new Error(\"安装期间所选脚本内容发生变化，请关闭编辑器后重试。\");\n  }\n  try {\n    manager.writeString(path, updated);\n    if (manager.readString(path) !== updated) throw new Error(\"安装校验失败\");\n  } catch {\n    try {\n      manager.writeString(path, original);\n      if (manager.readString(path) !== original) throw new Error(\"恢复校验失败\");\n    } catch {\n      throw new Error(\"写入和自动恢复失败，请重新导入原来的「\" + name + \"」。\");\n    }\n    throw new Error(\"安装未完成，原脚本已恢复。\");\n  }\n\n  return \"「\" + name + \"」的桥接已就绪。请运行该脚本。首次安装时，在 Home Assistant Webhook 菜单设置地址；此前保存过的地址可继续使用。\";\n}\n\nconst result = new Alert();\ntry {\n  result.title = \"安装完成\";\n  result.message = await installBridge();\n} catch (error) {\n  result.title = \"安装未完成\";\n  result.message = error.message;\n}\nif (result.message) {\n  result.addAction(\"确定\");\n  await result.presentAlert();\n}\n",
  "share_sheet_inputs": []
}
