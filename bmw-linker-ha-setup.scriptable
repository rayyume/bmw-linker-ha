{
  "always_run_in_app": true,
  "icon": {
    "color": "blue",
    "glyph": "mobile-alt"
  },
  "name": "bmw-linker-ha-setup",
  "script": "const bridgeCode = \"// Generated by scripts/build-inline-bridge.mjs.\\n// Paste above: await new Widget(Script.name(), {\\n{\\n  const pushVehicleState = async (snapshot, webhookUrl) => {\\n    if (!isHaWebhookUrl(webhookUrl)) {\\n      console.log(\\\"[My BMW HA] 请填写集成显示的完整 Webhook URL。\\\");\\n      return;\\n    }\\n\\n    const rawTimestamp = snapshot?.lastUpdatedAt;\\n    const reportedAt = rawTimestamp ? new Date(rawTimestamp) : null;\\n    if (!reportedAt || !Number.isFinite(reportedAt.getTime())) {\\n      console.log(\\\"[My BMW HA] 车辆数据缺少有效的上报时间。\\\");\\n      return;\\n    }\\n\\n    const fuel = snapshot.combustionFuelLevel;\\n    const electric = snapshot.electricChargingState;\\n    const security = snapshot.doorsState?.combinedSecurityState;\\n    const doorState = {\\n      LOCKED: \\\"LOCKED\\\",\\n      SECURED: \\\"LOCKED\\\",\\n      UNLOCKED: \\\"UNLOCKED\\\",\\n      SELECTIVE_LOCKED: \\\"UNLOCKED\\\",\\n      PARTIALLY_LOCKED: \\\"UNLOCKED\\\",\\n    }[security];\\n\\n    try {\\n      const request = new Request(webhookUrl);\\n      request.method = \\\"POST\\\";\\n      request.headers = { \\\"Content-Type\\\": \\\"application/json\\\" };\\n      request.timeoutInterval = 4;\\n      request.onRedirect = () => null;\\n      request.body = JSON.stringify({\\n        version: 1,\\n        reported_at: reportedAt.toISOString(),\\n        battery_percent: nonnegativeNumber(electric?.chargingLevelPercent),\\n        fuel_percent: nonnegativeNumber(fuel?.remainingFuelPercent),\\n        fuel_range_km: nonnegativeNumber(fuel?.range),\\n        electric_range_km: nonnegativeNumber(electric?.range),\\n        odometer_km: nonnegativeNumber(snapshot.currentMileage),\\n        door_state: doorState,\\n      });\\n\\n      const receipt = await request.loadJSON();\\n      if (request.response.statusCode !== 200) throw new Error();\\n      if (receipt?.mybmw_bridge === \\\"updated\\\") {\\n        console.log(\\\"[My BMW HA] 已更新车辆状态。\\\");\\n      } else if (receipt?.mybmw_bridge === \\\"unchanged\\\") {\\n        console.log(\\\"[My BMW HA] 已收到，车辆上报时间没有更新。\\\");\\n      } else {\\n        throw new Error();\\n      }\\n    } catch {\\n      console.log(\\\"[My BMW HA] 未收到确认，请检查网络、Webhook 地址和车辆数据。\\\");\\n    }\\n  };\\n\\n  function isHaWebhookUrl(value) {\\n    return /^https?:\\\\/\\\\/[^\\\\s/?#@\\\\\\\\]+\\\\/api\\\\/webhook\\\\/[a-f0-9]{64}$/.test(value);\\n  }\\n\\n  function nonnegativeNumber(value) {\\n    if (typeof value === \\\"string\\\" && value.trim() !== \\\"\\\") value = Number(value);\\n    return Number.isFinite(value) && value >= 0 ? value : undefined;\\n  }\\n\\n  const webhookKey = \\\"bmw-linker-ha.webhook-url.\\\" + Script.name();\\n  const menuName = \\\"bmwLinkerHaWebhook\\\";\\n  const readWebhook = () => Keychain.contains(webhookKey) ? Keychain.get(webhookKey) : \\\"\\\";\\n  const webhookStatus = () => readWebhook() ? \\\"已设置\\\" : \\\"未设置\\\";\\n\\n  Widget = class extends Widget {\\n    async getAppViewOptions() {\\n      const options = await super.getAppViewOptions();\\n      return {\\n        ...options,\\n        settingItems: [\\n          {\\n            name: menuName,\\n            label: \\\"Home Assistant Webhook\\\",\\n            type: \\\"cell\\\",\\n            icon: { name: \\\"house.fill\\\", color: \\\"#1699cb\\\" },\\n            needLoading: true,\\n            desc: webhookStatus(),\\n          },\\n          ...options.settingItems,\\n        ],\\n        onItemClick: async (item, ...args) => {\\n          if (item.name !== menuName) return options.onItemClick(item, ...args);\\n\\n          const alert = new Alert();\\n          alert.title = \\\"Home Assistant Webhook\\\";\\n          alert.message = \\\"粘贴 HA 集成生成的完整 Webhook URL。清空后保存可停用推送。\\\";\\n          alert.addSecureTextField(\\\"Webhook URL\\\", readWebhook());\\n          alert.addAction(\\\"保存\\\");\\n          alert.addCancelAction(\\\"取消\\\");\\n          if (await alert.presentAlert() === 0) {\\n            const url = alert.textFieldValue(0).trim();\\n            if (!url) {\\n              if (Keychain.contains(webhookKey)) Keychain.remove(webhookKey);\\n            } else if (isHaWebhookUrl(url)) {\\n              Keychain.set(webhookKey, url);\\n            } else {\\n              await this.generateAlert(\\\"地址有误\\\", \\\"请粘贴 HA 集成显示的完整 Webhook URL。\\\", [\\\"确定\\\"]);\\n            }\\n          }\\n          return { desc: { value: webhookStatus() } };\\n        },\\n      };\\n    }\\n\\n    async getData(forceRefresh = false) {\\n      const data = await super.getData(forceRefresh);\\n      if (!forceRefresh && data?.properties && !data.black) {\\n        const url = readWebhook();\\n        if (url) await pushVehicleState(data.properties, url);\\n      }\\n      return data;\\n    }\\n  };\\n}\\n\";\nconst startup = \"await new Widget(Script.name(), {\";\nconst configuredMenu = 'const menuName = \"bmwLinkerHaWebhook\";';\n\nfunction findOriginalScript() {\n  const local = FileManager.local();\n  const fileName = \"bmw-linker.js\";\n  const sibling = module.filename.replace(/[^/]+$/, fileName);\n  if (sibling !== module.filename && local.fileExists(sibling)) {\n    const manager = local.isFileStoredIniCloud(sibling) ? FileManager.iCloud() : local;\n    return { manager, path: sibling };\n  }\n\n  const candidates = [{ manager: local, path: local.joinPath(local.documentsDirectory(), fileName) }];\n  try {\n    const cloud = FileManager.iCloud();\n    const path = cloud.joinPath(cloud.documentsDirectory(), fileName);\n    if (path !== candidates[0].path) candidates.push({ manager: cloud, path });\n  } catch {\n    // The device may have iCloud Drive disabled.\n  }\n\n  const found = candidates.filter(({ manager, path }) => manager.fileExists(path));\n  if (found.length > 1) {\n    throw new Error(\"本机和 iCloud 都有 bmw-linker。请把安装脚本放到你使用的 bmw-linker 所在位置。\");\n  }\n  if (found.length === 0) {\n    throw new Error(\"找不到名为 bmw-linker 的脚本。请确认原脚本已导入 Scriptable，且名称为 bmw-linker。\");\n  }\n  return found[0];\n}\n\nfunction addBridge(original) {\n  if (original.includes(configuredMenu)) return original;\n\n  // Remove the exact module call from the previous installation guide.\n  const oldModuleCall = /^([ \\t]*let data = await this\\.getData\\(\\);\\r?\\n)[ \\t]*if \\(data\\?\\.properties && !data\\.black\\) \\{\\r?\\n[ \\t]*try \\{\\r?\\n[ \\t]*await importModule\\(\"(?:bmw-linker-ha-bridge|scriptable-bridge)\"\\)\\.pushVehicleState\\(data\\.properties\\);\\r?\\n[ \\t]*\\} catch \\{\\r?\\n[ \\t]*console\\.log\\(\"\\[My BMW HA\\] 无法调用发送脚本，请检查脚本名称。\"\\);\\r?\\n[ \\t]*\\}\\r?\\n[ \\t]*\\}\\r?\\n/m;\n  const updated = original.replace(oldModuleCall, \"$1\");\n  if (/pushVehicleState|HA_WEBHOOK_URL|\\[My BMW HA\\]/.test(updated)) {\n    throw new Error(\"检测到其他版本的桥接代码。安装器已保留原脚本，请先用未加桥接的 bmw-linker 运行安装。\");\n  }\n  if (updated.split(startup).length !== 2 || !updated.includes(\"async getAppViewOptions()\")) {\n    throw new Error(\"这个 bmw-linker 版本的入口与安装器不匹配，原脚本已保留。\");\n  }\n\n  const lineEnding = updated.includes(\"\\r\\n\") ? \"\\r\\n\" : \"\\n\";\n  const patch = bridgeCode.replace(/\\n/g, lineEnding);\n  return updated.replace(startup, () => patch + lineEnding + startup);\n}\n\nasync function installBridge() {\n  const { manager, path } = findOriginalScript();\n  if (manager.isFileStoredIniCloud(path)) await manager.downloadFileFromiCloud(path);\n  const original = manager.readString(path);\n  const updated = addBridge(original);\n  if (updated === original) return \"已经装好。请打开 bmw-linker，在菜单中选择 Home Assistant Webhook。\";\n\n  const local = FileManager.local();\n  const backups = local.joinPath(local.documentsDirectory(), \"bmw-linker-ha-backups\");\n  if (!local.fileExists(backups)) local.createDirectory(backups);\n  const backupName = \"bmw-linker-\" + new Date().toISOString().replace(/[:.]/g, \"-\") + \".js.bak\";\n  const backup = local.joinPath(backups, backupName);\n  local.writeString(backup, original);\n  if (local.readString(backup) !== original) {\n    throw new Error(\"备份校验失败，原脚本已保留。\");\n  }\n\n  if (manager.readString(path) !== original) {\n    throw new Error(\"安装期间 bmw-linker 内容发生变化，请关闭编辑器后重试。\");\n  }\n  try {\n    manager.writeString(path, updated);\n    if (manager.readString(path) !== updated) throw new Error(\"安装校验失败\");\n  } catch {\n    try {\n      manager.writeString(path, original);\n      if (manager.readString(path) !== original) throw new Error(\"恢复校验失败\");\n    } catch {\n      throw new Error(\"写入和自动恢复失败。原代码保存在 bmw-linker-ha-backups/\" + backupName + \"。\");\n    }\n    throw new Error(\"安装未完成，原脚本已恢复。\");\n  }\n\n  return \"已更新原来的 bmw-linker。请返回脚本列表，运行 bmw-linker，在 Home Assistant Webhook 菜单中填写地址。\";\n}\n\nconst result = new Alert();\ntry {\n  result.title = \"安装完成\";\n  result.message = await installBridge();\n} catch (error) {\n  result.title = \"安装未完成\";\n  result.message = error.message;\n}\nresult.addAction(\"确定\");\nawait result.presentAlert();\n",
  "share_sheet_inputs": []
}
